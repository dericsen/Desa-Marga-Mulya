# Koneksi PostgreSQL (Neon / Supabase / lokal). Integrasi Neon di Vercel otomatis mengisi DATABASE_URL.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Akun admin awal CMS (dibuat otomatis saat build pertama bila belum ada admin)
ADMIN_EMAIL=admin@margamulya.desa.id
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Rahasia untuk menandatangani sesi login (string acak panjang)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Asisten AI "Tanya Desa" (Google Gemini). Kosongkan untuk memakai mode pencarian data lokal.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Penyimpanan gambar (Vercel Blob). Kosongkan untuk menyimpan gambar langsung di database.
BLOB_READ_WRITE_TOKEN=
