{
  "name": "desa-marga-mulya",
  "version": "1.0.0",
  "private": true,
  "description": "Website & CMS Desa Marga Mulya, Kecamatan Mauk, Kabupaten Tangerang, Banten",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "build:app": "next build",
    "start": "next start",
    "start:railway": "node scripts/migrate.mjs && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/migrate.mjs",
    "db:reset": "node scripts/migrate.mjs --reset"
  },
  "dependencies": {
    "@vercel/blob": "^1.0.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.7",
    "postgres": "^3.4.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
